APP_ENV=development
REPORT_TIMEZONE=America/Los_Angeles
# Set these only after the canonical Phase 2 report is accepted and checksummed.
PHASE2_LIVE_WEATHER_ACCEPTED=false
PHASE2_WEATHER_EVIDENCE_SHA256=
DATABASE_PATH=/data/mlb_phase1.db
ARTIFACT_DIR=/data/artifacts
SERVICE_AUTH_TOKEN=replace-with-a-long-random-token
ODDS_API_KEY=replace-with-your-odds-api-key
ODDS_REGIONS=us,us2
ODDS_MARKETS=h2h,spreads,totals
ODDS_FORMAT=american
ODDS_FRESH_SECONDS=120
ODDS_STALE_SECONDS=300
ODDS_FUTURE_TOLERANCE_SECONDS=30
ODDS_CONSENSUS_MIN_BOOKS=2
ODDS_CONSENSUS_MODERATE_BOOKS=4
ODDS_CONSENSUS_HIGH_BOOKS=7
ODDS_MAX_ATTEMPTS=3
ODDS_RETRY_MAX_SECONDS=30
# NWS requires an application identity. Replace this with a real monitored contact.
NWS_USER_AGENT=replace-with-app-name-and-real-contact
OPENWEATHER_ENABLED=true
OPENWEATHER_API_KEY=replace-with-your-openweather-key
# The reviewed collector contract is pinned to One Call API 3.0.
OPENWEATHER_API_VERSION=3.0
WEATHER_COMPARE_ENABLED=true
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
